# Server Port
PORT=3000
HOST=0.0.0.0

# Database Storage Path
DB_PATH=data/router.db

# JWT Secret for Session Signing (leave blank to auto-generate and persist in database)
JWT_SECRET=neko-router-super-secret-key-change-me

# Node Environment
NODE_ENV=production

# Docker: Auto-pull latest code on container start (true/false)
AUTO_UPDATE=false
